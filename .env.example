VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-or-legacy-anon-key

# Cloudflare Turnstile site key (public). Required once Captcha is enabled in Supabase Auth;
# leave empty to disable the captcha widget locally. Test keys: 1x00000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=

# Development only: after Supabase login, show the local demo without calling the Go API.
VITE_AUTH_DASHBOARD_PREVIEW=false
